# Merge the desired settings into the project's .env; no local model is used.
MEMORY_PROVIDER=mem0
MEMORY_PATH=./data/mem0
MEMORY_SEARCH_TIMEOUT=1.2
MEMORY_TOP_K=8
MEMORY_CONTEXT_CHARS=2500
# Existing DashScope deployments automatically reuse LLM_BASE_URL / LLM_API_KEY,
# text-embedding-v4 and 1024 dimensions. Other providers must set the model/dimensions.
# To use a separate cloud embedding endpoint, uncomment and fill these:
# MEMORY_EMBEDDING_BASE_URL=
# MEMORY_EMBEDDING_API_KEY=
# MEMORY_EMBEDDING_MODEL=text-embedding-v4
# MEMORY_EMBEDDING_DIMS=1024
# MEMORY_PROVIDER=disabled disables Mem0 retrieval/indexing; existing chat/profile still work.

# 云端聊天示例：填写自己的密钥，并确认地址、地域与模型权限匹配。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-plus
# 地址应包含版本前缀（如 /v1），网关自动追加 /chat/completions。
# 支持 OpenAI-compatible Chat Completions；密钥仅保存在服务端。
LLM_JSON_MODE=true
LLM_TIMEOUT=45
TURN_TIMEOUT=180
# 流式回复上限；普通陪伴默认生成短回复
REPLY_MAX_TOKENS=600
# 部分兼容服务不接受 stream_options，默认关闭用量扩展
LLM_STREAM_USAGE=false
# 可选厂商参数 JSON；按官方文档关闭长思考，例如部分服务的 enable_thinking=false。
# 不能跨厂商通用，不确定时保持 {}。
LLM_EXTRA_BODY={}
# 后台画像整理：显式新信息/纠正、每 N 轮或结束会话时触发
BACKGROUND_ENABLED=true
BACKGROUND_INTERVAL=1
BACKGROUND_TIMEOUT=120
# 可选：按任务使用不同的云端模型；留空则复用 LLM_MODEL
LLM_MODEL_ANALYSIS=
# 前台默认一次 respond；复杂场景先调用 prepare，再 respond
LLM_MODEL_RESPOND=
LLM_MODEL_PREPARE=
# 以下三项为旧流程配置；GENERATION 也作为前台模型的兼容回退。
LLM_MODEL_PLANNING=
LLM_MODEL_GENERATION=
LLM_MODEL_REVIEW=
# 按需摘要与显式云端评估
LLM_MODEL_SUMMARIZATION=
LLM_MODEL_EVALUATION=
# 固定脚本演示默认关闭；启动时传 --demo 也可显式开启
DEMO_ENABLED=false
# 经 HTTPS 部署时设为 true；本机 HTTP 开发保持 false
COOKIE_SECURE=false
# Mem0 OSS + 本地 Qdrant；Embedding 调用云端，不需要 Mem0 平台账号。
MEMORY_PROVIDER=mem0
MEMORY_PATH=./data/mem0
MEMORY_SEARCH_TIMEOUT=1.2
MEMORY_TOP_K=8
MEMORY_CONTEXT_CHARS=2500
# DashScope 默认继承聊天端点与密钥，使用 text-embedding-v4 / 1024 维。
# 独立配置时再取消注释并填写；不要用空值覆盖自动继承。
# MEMORY_EMBEDDING_BASE_URL=
# MEMORY_EMBEDDING_API_KEY=
# MEMORY_EMBEDDING_MODEL=text-embedding-v4
# MEMORY_EMBEDDING_DIMS=1024
# 仅前台回复的附加请求字段（可选；合法 JSON）
LLM_RESPOND_EXTRA_BODY={}
DATABASE_URL=sqlite:///./data/deep_empathy.db

# 测试：刷新/重开页面会清空当前浏览器身份的历史与记忆，恢复初始画像。
# 需要持续保存对话与画像时改为 false。
TEST_RESET_ON_RELOAD=true

# 书屋所在地天气，不是访客 GPS。更换城市时一起修改经纬度。
WEATHER_ENABLED=true
WEATHER_LOCATION=广州
WEATHER_LATITUDE=23.1291
WEATHER_LONGITUDE=113.2644

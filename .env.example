# 所有云端模型配置留空，后续填写。BASE_URL 为服务根地址，具体路径由适配器处理。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-plus
# 地址应包含版本前缀（如 /v1），网关自动追加 /chat/completions。
# 支持 OpenAI-compatible Chat Completions；密钥仅保存在服务端。
LLM_JSON_MODE=true
LLM_TIMEOUT=45
TURN_TIMEOUT=180
# 流式回复上限；普通陪伴默认生成短回复
REPLY_MAX_TOKENS=600
# 部分兼容服务不接受 stream_options，默认关闭用量扩展
LLM_STREAM_USAGE=false
# 可选厂商参数 JSON；按官方文档关闭长思考，例如部分服务的 enable_thinking=false。
# 不能跨厂商通用，不确定时保持 {}。
LLM_EXTRA_BODY={}
# 后台画像整理：显式新信息/纠正、每 N 轮或结束会话时触发
BACKGROUND_ENABLED=true
BACKGROUND_INTERVAL=1
BACKGROUND_TIMEOUT=120
# 可选：按任务使用不同的云端模型；留空则复用 LLM_MODEL
LLM_MODEL_ANALYSIS=
# 前台默认一次 respond；复杂场景先调用 prepare，再 respond
LLM_MODEL_RESPOND=
LLM_MODEL_PREPARE=
# 以下保留供旧流程组件/离线实验；新实时主流程不调用它们
LLM_MODEL_PLANNING=
LLM_MODEL_GENERATION=
LLM_MODEL_REVIEW=
LLM_MODEL_SUMMARIZATION=
LLM_MODEL_EVALUATION=
# 固定脚本演示默认关闭；启动时传 --demo 也可显式开启
DEMO_ENABLED=false
# 经 HTTPS 部署时设为 true；本机 HTTP 开发保持 false
COOKIE_SECURE=false
# 预留：本版尚未接入 embedding，使用确定性关键词召回
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
DATABASE_URL=sqlite:///./data/deep_empathy.db

# During testing, page initialization resets this browser identity to the seed profile.
TEST_RESET_ON_RELOAD=true

# Bookshop weather location (not the visitor GPS location).
WEATHER_ENABLED=true
WEATHER_LOCATION=广州
WEATHER_LATITUDE=23.1291
WEATHER_LONGITUDE=113.2644
